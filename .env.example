# Copy to .env and fill in. Never commit the real .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Provider key used when LLM_BASE_URL points away from OpenRouter.
LLM_API_KEY=
NEO4J_URI=neo4j+s://....databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# LLM provider + model routing (all optional — defaults target OpenRouter).
# The active provider is decided by LLM_BASE_URL; the key by LLM_API_KEY
# (falls back to OPENROUTER_API_KEY above when unset). Two ready configs:
#
# --- Groq (fast LPUs, sub-2s composes; needs a Groq key) ---
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_API_KEY=gsk-...
#PRIMARY_MODEL=openai/gpt-oss-120b
# Retry the reliable model as fallback: gpt-oss-20b fails Groq's server-side
# schema validation on the full compose prompt, so it only degrades things.
#FALLBACK_MODEL=openai/gpt-oss-120b
#
# --- OpenRouter (free-tier defaults) ---
#LLM_BASE_URL=https://openrouter.ai/api/v1
#PRIMARY_MODEL=z-ai/glm-5.2:free
#FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#
#LLM_MAX_TOKENS=1400
#LLM_TIMEOUT=15
#LLM_TOTAL_BUDGET=30

# NVIDIA NIM — cross-provider fallback behind the primary provider (Groq):
# a different capacity pool the ladder hops to when the primary 429s.
# Unset key or model disables the rung (ladder stays primary-only).
# Validated config: nemotron-3-super-120b-a12b with json_object + thinking off
# (NVIDIA NIM hangs on response_format json_schema — agents.py adapts). The
# older nemotron-3.5-lightning-30b-a3b returns 404 on the chat endpoint.
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#NVIDIA_API_KEY=nvapi-...
#NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Brevo transactional mail for /api/lead (read per request; both unset = saved-only).
MAIL_API_KEY=
MAIL_FROM=
